# neon postgres — get this from your neon project dashboard > connection string
# format: postgresql://user:password@host.neon.tech/database?sslmode=require
DATABASE_URL=

NEXT_PUBLIC_API_URL=http://localhost:3000/api

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pusher (realtime — optional)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Media APIs
# tmdb (movies/tv) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# igdb (games) — https://api-docs.igdb.com/#account-creation
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# comicvine (comics) — https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=
# listen notes (podcasts) — https://www.listennotes.com/api/
LISTEN_NOTES_API_KEY=
# boardgamegeek — https://boardgamegeek.com/wiki/page/Thread_1300567
BGG_API_KEY=

# Optional: LiteLLM gateway for AI features
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=
